{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["node", "@playwright/test"]
  },
  "include": ["e2e/**/*.ts", "e2e/**/*.tsx", "playwright.config.ts"]
}
