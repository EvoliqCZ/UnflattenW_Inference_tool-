[Unit]
Description=Unflatten single-GPU diagnostic worker
After=local-fs.target unflatten-diagnostic-api.service
ConditionPathExists=/etc/unflatten/service.env

[Service]
Type=simple
User=unflatten
Group=unflatten
SupplementaryGroups=video render
EnvironmentFile=/etc/unflatten/service.env
WorkingDirectory=/srv/unflatten
ExecStart=/srv/unflatten/.venv/bin/python -m unflatten.service.worker_cli --job-db ${UNFLATTEN_DATA_DIR}/jobs.sqlite3 --artifact-root ${UNFLATTEN_DATA_DIR}/artifacts --work-root ${UNFLATTEN_DATA_DIR}/work --sandbox-image ${UNFLATTEN_SANDBOX_IMAGE} --sandbox-runtime ${UNFLATTEN_SANDBOX_RUNTIME} --model-bundle ${UNFLATTEN_MODEL_BUNDLE} --model-id ${UNFLATTEN_MODEL_ID} --revision ${UNFLATTEN_MODEL_REVISION} --attention-implementation sdpa --device ${UNFLATTEN_DEVICE} --worker-id worker_gpu_0
Restart=on-failure
RestartSec=5s
TimeoutStopSec=150s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/unflatten-diagnostic

[Install]
WantedBy=unflatten-diagnostic.target
