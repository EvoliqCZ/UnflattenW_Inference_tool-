# Portable environment template for deploy/service/service.sh (design D9).
# Copy this file, fill in every REPLACE_WITH_* value, and either `source`
# your copy before calling service.sh or point UNFLATTEN_SERVICE_ENV at it.
# No path here is required by the code -- everything site-specific is a
# variable. service.sh creates UNFLATTEN_DATA_DIR's subdirectories at 0700.

UNFLATTEN_DATA_DIR=$HOME/unflatten-service        # jobs.sqlite3, artifacts/, work/, run/, logs/ (created 0700)
UNFLATTEN_MODEL_BUNDLE=REPLACE_WITH_MODEL_BUNDLE_DIR   # scripts/build_model_bundle.py build output (D7)
UNFLATTEN_MODEL_BUNDLE_SHA256=                    # optional pin on the bundle manifest's own sha256
UNFLATTEN_PRINCIPAL_FILE=REPLACE_WITH_PRINCIPAL_FILE   # 0400, owned by the account running the API (auth.py)
UNFLATTEN_SANDBOX_IMAGE=sha256:REPLACE_WITH_VERIFIED_DIGEST   # or name@sha256:<digest>, digest-pinned
UNFLATTEN_SANDBOX_RUNTIME=docker                  # docker | podman
UNFLATTEN_SANDBOX_ALLOW_ROOTFUL=0
UNFLATTEN_HOST=127.0.0.1
UNFLATTEN_PORT=8000
UNFLATTEN_DEVICE=cuda:0
UNFLATTEN_MODEL_ID=Qwen/Qwen3-VL-4B-Instruct
UNFLATTEN_MODEL_REVISION=REPLACE_WITH_PINNED_REVISION
UNFLATTEN_PRECISION=bf16                          # bf16 | int8 | fp8 | int4 -- must match the model bundle's own precision identity
UNFLATTEN_KV_CACHE=bf16                           # bf16 | fp8
UNFLATTEN_POLICY=                                 # empty = the approved bundled runtime_policy.json
UNFLATTEN_PYTHON=                                 # empty = "uv run --no-sync python"
HF_HOME=                                          # optional, a local HF snapshot cache directory
TORCH_DISABLE_NATIVE_JIT=                         # set to 1 only on hosts that need it (no C compiler)
