# Copy to deploy/docker/.env and fill in every REPLACE_WITH_* value.
# `docker compose` auto-loads a `.env` file from the same directory as the
# compose file (deploy/docker/), so run `docker compose` from here or with
# `-f deploy/docker/compose.yaml`.
#
# See docs/RUNBOOK.md §10 for the full operator checklist (DEC-044) and
# deploy/docker/README.md for what each variable does in this compose setup
# specifically. No secret belongs in this file once filled in for real use
# beyond your own workstation -- keep it out of git (deploy/docker/.env and
# deploy/docker/models/ are already in .gitignore; verify before committing).

# --- Networking -------------------------------------------------------
# published as 127.0.0.1:$UNFLATTEN_PORT only. 8420 chosen to avoid the many
# uvo-*/Stratus containers already bound to 127.0.0.1:8000 and neighbours on
# this machine -- check `ss -ltn` before changing it.
UNFLATTEN_PORT=8420
# HOST address the port is published on. Keep 127.0.0.1 on a single-user
# workstation: run-local.sh then offers a password-only first-run setup.
# Any other address (e.g. a LAN IP or 0.0.0.0) exposes the service to that
# network: run-local.sh turns tokenless setup off and prints a one-click
# setup link with the token instead; add the LAN host name to
# UNFLATTEN_WEB_ALLOWED_HOSTS below as well.
UNFLATTEN_BIND_ADDRESS=127.0.0.1
# Empty = decided by run-local.sh from UNFLATTEN_BIND_ADDRESS (owner
# 2026-09-29, DEC-052 addendum). 0 = always require the setup link even on
# loopback (SSH tunnel / reverse proxy in front). 1 is refused for a
# non-loopback bind.
UNFLATTEN_SETUP_TOKENLESS=

# --- Model bundle (host-built via scripts/build_model_bundle.py) ------
# Directory bind-mounted read-only at /models in api+worker. Build it with:
#   uv run python scripts/build_model_bundle.py build \
#     --checkpoint runs/s4-v15b/checkpoint-step-000027915.pt \
#     --run-dir runs/s4-v15b --out ./models
UNFLATTEN_HOST_MODEL_BUNDLE_DIR=./models
# optional pin printed by `build_model_bundle.py verify`
UNFLATTEN_MODEL_BUNDLE_SHA256=
# T43: host path bind-mounted read-only at /config/models.json in api+worker
# (DEC-044 Dodatok D §1 models variants config, see models.example.json).
# The api reads it always (GET /v1/models); the worker only if you also set
# UNFLATTEN_MODELS_CONFIG below -- it never combines with UNFLATTEN_MODEL_BUNDLE.
UNFLATTEN_MODELS_CONFIG_FILE=./models.json

# --- Backbone identity (RFC004-ERRATA-003 / DEC-044) -------------------
UNFLATTEN_MODEL_ID=Qwen/Qwen3-VL-4B-Instruct
UNFLATTEN_MODEL_REVISION=REPLACE_WITH_PINNED_REVISION
UNFLATTEN_ATTENTION_IMPLEMENTATION=sdpa
UNFLATTEN_DEVICE=cuda:0

# --- Sandbox (deploy/pdf-sandbox) --------------------------------------
# T43/DEC-052: compose now builds `unflatten/pdf-sandbox:local` itself (the
# `sandbox-image` service) -- owner rule "everyone builds containers
# themselves", no registry push. Leave empty to use that local tag (compose
# default); a digest/ID pin stays possible and recommended off a single-user
# workstation (docs/RUNBOOK.md §10).
UNFLATTEN_SANDBOX_IMAGE=
UNFLATTEN_SANDBOX_RUNTIME=docker
# T47: do not set this by hand -- deploy/local/run-local.sh's
# compose.sandbox-socket.yaml override sets it for you once you accept
# UNFLATTEN_ACCEPT_ROOTFUL_SOCKET below. Two separate flags saying the same
# yes would be confusing; this one only records the override's own effect.
UNFLATTEN_SANDBOX_ALLOW_ROOTFUL=0
# T47: the ONE consent flag deploy/local/run-local.sh reads. `run-local.sh
# up` refuses (rc=2) without it set to 1 -- see compose.sandbox-socket.yaml's
# warning: mounting the host docker socket into the worker is root-equivalent
# control of this machine. Never set ALLOW_ROOTFUL above without this one.
UNFLATTEN_ACCEPT_ROOTFUL_SOCKET=0
# Absolute HOST path, required ONLY when using compose.sandbox-socket.yaml
# (see the warning in that file) -- must not be under a symlinked path.
# deploy/local/run-local.sh fills this in with $HOME/unflatten-diagnostic-data
# when it creates a fresh .env.
UNFLATTEN_HOST_DATA_DIR=

# --- Runtime policy override (optional; empty = bundled runtime_policy.json)
UNFLATTEN_POLICY=

# --- Hugging Face cache -- OPTIONAL, only needed for an old-style bundle
# whose manifest does NOT embed the Qwen backbone under backbone/ (DEC-050:
# the model now ships as one complete package -- bundle backbone + our
# weights in one directory/repo, loaded fully offline from it; the separate
# HF download below is compatibility for a bundle built before DEC-050).
# Default: $UNFLATTEN_DATA_DIR/hf-cache, inside the shared data volume/bind
# mount -- leave empty unless you want it somewhere else inside the container.
# T43: compose.yaml now defaults this for `api` too (not just `worker`), so
# GET /v1/models' `downloaded` status and the base-model pin check see the
# same cache the worker downloads/loads from.
HF_HOME=
HF_TOKEN=
# 1 = no network at model-load time (requires the backbone already cached,
#     or a DEC-050 complete bundle that needs no download at all).
# 0 = allow the first start of an old-style bundle (or a UI-driven variant
#     download, DEC-044 Dodatok D point 3) to reach huggingface.co.
UNFLATTEN_HF_HUB_OFFLINE=0

# --- Model variants config (DEC-044 Dodatok D §1) ----------------------
# T47: compose.yaml now hardcodes UNFLATTEN_MODELS_CONFIG=/config/models.json
# for the worker itself (not read from here) -- the WORKER always loads its
# resident variant from UNFLATTEN_MODELS_CONFIG_FILE above, never from a
# bare UNFLATTEN_MODEL_BUNDLE anymore. `deploy/local/dev-bundle.sh` builds
# local bundles and writes that file; `deploy/local/run-local.sh up` refuses
# to start if it is missing or fails validation. UNFLATTEN_PRECISION/
# UNFLATTEN_KV_CACHE below are unused while UNFLATTEN_MODELS_CONFIG is set
# (each variant already names its own precision/kv_cache) -- kept only for
# the older single --model-bundle path some other deployment may still use.
UNFLATTEN_PRECISION=
UNFLATTEN_KV_CACHE=
# What backs the decode's KV cache (worker_cli --kv-cache-mode). Empty =
# "static" (owner decision 2026-09-29: preallocated cache, -15 % per decode
# step, identical output, up to ~650 MiB more VRAM); "bf16_dynamic" restores
# the pre-2026-09-29 behaviour. Applies to every variant.
UNFLATTEN_KV_CACHE_MODE=
# fp8 decoder only (worker_cli --fp8-shared-input-quant): q/k/v and gate/up
# share one activation quantization, bit-identical output
# (docs/runs/fp8-qkv-fusion-2026-09-29.md). Empty = default: ON for an fp8
# decoder, off for others. 0/false/no/off turns it off; 1/true/yes/on requests it
# explicitly (then an explicit non-fp8 --precision is refused at startup).
UNFLATTEN_FP8_SHARED_INPUT_QUANT=
# Loop guard (worker_cli --loop-guard): empty = default v3 with arm r2 (DEC-055,
# docs/runs/loop-guard-v3-2026-09-29.md); "bundle" keeps the model bundle's own
# value (v2), "v2" forces v2. UNFLATTEN_LOOP_GUARD_V3_ARM picks another v3 arm.
UNFLATTEN_LOOP_GUARD=
UNFLATTEN_LOOP_GUARD_V3_ARM=
# InferenceEngine ids this worker may run a variant under, comma-separated
# (design §17.5); "native" is always the reference engine.
UNFLATTEN_ENGINES=native
# DeepStack bundles (S4 v16) need UNFLATTEN_DEEPSTACK=1.
# UNFLATTEN_DEEPSTACK=1
# variant_id to load at worker startup from UNFLATTEN_MODELS_CONFIG; empty
# defaults to the config's own default_variant.
UNFLATTEN_MODEL_VARIANT=

# --- Host quirk (docs/RUNBOOK.md "H200 host quirks"); leave empty unless
# your host actually lacks a C compiler for torch's native JIT.
TORCH_DISABLE_NATIVE_JIT=

# --- Web UI (design §6.1/§8.4) ------------------------------------------
# 'legacy' = today's single UI page; 'spa' serves the built React app baked
# into the image by the `web-builder` Docker stage. Stays 'legacy' by default
# until chunk 4 flips the default.
UNFLATTEN_WEB_UI=legacy
# Comma-separated Host header allowlist, port never included.
UNFLATTEN_WEB_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
UNFLATTEN_WEB_SESSION_IDLE_SECONDS=43200
UNFLATTEN_WEB_SESSION_MAX_SECONDS=604800
# Reported verbatim in GET /v1/settings; run-local.sh fills this in with
# `git rev-parse --short HEAD` when it copies this file to .env.
UNFLATTEN_GIT_SHA=
