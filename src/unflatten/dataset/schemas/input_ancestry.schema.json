{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unflatten.dev/schemas/rfc003/input_ancestry.schema.json",
  "title": "RFC003 Input Ancestry envelope (§30.10 D0 subset, RFC003-ERRATA-003 E3 model_candidate branch)",
  "$comment": "Immutable per-TaskView/TaskExample ancestry of every input pixel. `source_kind` has four branches: the RFC003 §30.10 base three (render_page, task_input, fragment_page) plus ERRATA-003 E3's model_candidate (a frozen-model hypothesis or a controlled corruption). Every binding declares every field; fields that do not apply to a branch are explicitly null (§30.10 closing paragraph). input_ancestry_hash = H('rfc003.input-ancestry/v1', payload without input_ancestry_hash).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_ancestry_schema_version",
    "input_ancestry_hash",
    "authority_ref",
    "render_view_id",
    "parent_task_view_id",
    "bindings"
  ],
  "properties": {
    "input_ancestry_schema_version": { "const": "0.2.0" },
    "input_ancestry_hash": { "$ref": "#/$defs/sha256" },
    "authority_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_bundle_id", "candidate_id"],
      "properties": {
        "document_bundle_id": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^bundle_[0-9a-f]{64}$" }]
        },
        "candidate_id": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^candidate_[0-9a-f]{64}$" }]
        }
      }
    },
    "render_view_id": { "type": "string", "pattern": "^render_[0-9a-f]{64}$" },
    "parent_task_view_id": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^task_[0-9a-f]{64}$" }]
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/binding" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "content_ref": {
      "$comment": "§30.10 binding artifact shape: content identity only, no transport 'ref'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes", "mime_type"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "mime_type": { "type": "string", "minLength": 1 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_ordinal",
        "input_artifact",
        "source_kind",
        "source_page_index",
        "source_input_ordinal",
        "source_fragment_id",
        "source_artifact",
        "derivation_kind",
        "transform_chain_hash",
        "lineage_edge_id",
        "candidate_origin",
        "producer_checkpoint_sha256",
        "producer_component_lock_hash",
        "producer_decode_policy_hash",
        "producer_exposure",
        "corruption_policy_hash"
      ],
      "properties": {
        "input_ordinal": { "type": "integer", "minimum": 0 },
        "input_artifact": { "$ref": "#/$defs/content_ref" },
        "source_kind": {
          "enum": ["render_page", "task_input", "fragment_page", "model_candidate"]
        },
        "source_page_index": { "type": "integer", "minimum": 0 },
        "source_input_ordinal": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
        },
        "source_fragment_id": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^fragment_[0-9a-f]{64}$" }]
        },
        "source_artifact": { "$ref": "#/$defs/content_ref" },
        "derivation_kind": { "enum": ["identity", "transform_chain"] },
        "transform_chain_hash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "lineage_edge_id": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^edge_[0-9a-f]{64}$" }]
        },
        "candidate_origin": {
          "$comment": "ERRATA-003 E3: non-null iff source_kind == model_candidate.",
          "oneOf": [{ "type": "null" }, { "enum": ["frozen_model", "controlled_corruption"] }]
        },
        "producer_checkpoint_sha256": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "producer_component_lock_hash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "producer_decode_policy_hash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "producer_exposure": {
          "$comment": "ERRATA-003 E3 rule 5: named, never inferred.",
          "oneOf": [
            { "type": "null" },
            { "enum": ["in_sample", "out_of_fold", "earlier_checkpoint"] }
          ]
        },
        "corruption_policy_hash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        }
      }
    }
  }
}
