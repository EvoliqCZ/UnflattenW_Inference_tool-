{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unflatten.dev/schemas/service/runtime_policy.schema.json",
  "title": "HTTP conversion service runtime policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service_runtime_policy_schema_version",
    "policy_version",
    "raster_dpi",
    "max_upload_bytes",
    "max_pdf_pages",
    "max_page_width_points",
    "max_page_height_points",
    "max_raster_width_pixels",
    "max_raster_height_pixels",
    "max_raster_pixels",
    "max_png_bytes",
    "max_sandbox_output_bytes",
    "max_sandbox_tmpfs_bytes",
    "scanner_wall_time_seconds",
    "scanner_cpu_time_seconds",
    "max_sandbox_memory_bytes",
    "max_sandbox_processes",
    "max_sandbox_open_files",
    "global_active_jobs",
    "active_jobs_per_principal",
    "worker_inference_concurrency",
    "lease_duration_seconds",
    "heartbeat_interval_seconds",
    "max_attempts",
    "decode_steps_hard_ceiling",
    "max_prediction_ir_bytes",
    "crash_recovery_source_raster_seconds",
    "prediction_ir_retention_seconds",
    "metadata_retention_seconds",
    "diagnostic_docx_retention_seconds",
    "max_diagnostic_docx_bytes"
  ],
  "properties": {
    "service_runtime_policy_schema_version": { "const": "1.2.0" },
    "policy_version": { "$ref": "#/$defs/semver" },
    "raster_dpi": { "const": 300 },
    "max_upload_bytes": { "$ref": "#/$defs/positiveInteger" },
    "max_pdf_pages": { "$ref": "#/$defs/positiveInteger" },
    "max_page_width_points": { "$ref": "#/$defs/positiveInteger" },
    "max_page_height_points": { "$ref": "#/$defs/positiveInteger" },
    "max_raster_width_pixels": { "$ref": "#/$defs/positiveInteger" },
    "max_raster_height_pixels": { "$ref": "#/$defs/positiveInteger" },
    "max_raster_pixels": { "$ref": "#/$defs/positiveInteger" },
    "max_png_bytes": { "$ref": "#/$defs/positiveInteger" },
    "max_sandbox_output_bytes": { "$ref": "#/$defs/positiveInteger" },
    "max_sandbox_tmpfs_bytes": { "$ref": "#/$defs/positiveInteger" },
    "scanner_wall_time_seconds": { "$ref": "#/$defs/positiveInteger" },
    "scanner_cpu_time_seconds": { "$ref": "#/$defs/positiveInteger" },
    "max_sandbox_memory_bytes": { "$ref": "#/$defs/positiveInteger" },
    "max_sandbox_processes": { "$ref": "#/$defs/positiveInteger" },
    "max_sandbox_open_files": { "$ref": "#/$defs/positiveInteger" },
    "global_active_jobs": { "$ref": "#/$defs/positiveInteger" },
    "active_jobs_per_principal": { "$ref": "#/$defs/positiveInteger" },
    "worker_inference_concurrency": { "const": 1 },
    "lease_duration_seconds": { "$ref": "#/$defs/positiveInteger" },
    "heartbeat_interval_seconds": { "$ref": "#/$defs/positiveInteger" },
    "max_attempts": { "$ref": "#/$defs/positiveInteger" },
    "decode_steps_hard_ceiling": { "$ref": "#/$defs/positiveInteger" },
    "max_prediction_ir_bytes": { "$ref": "#/$defs/positiveInteger" },
    "crash_recovery_source_raster_seconds": { "$ref": "#/$defs/positiveInteger" },
    "prediction_ir_retention_seconds": { "$ref": "#/$defs/positiveInteger" },
    "metadata_retention_seconds": { "$ref": "#/$defs/positiveInteger" },
    "diagnostic_docx_retention_seconds": { "$ref": "#/$defs/positiveInteger" },
    "max_diagnostic_docx_bytes": { "$ref": "#/$defs/positiveInteger" }
  },
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
