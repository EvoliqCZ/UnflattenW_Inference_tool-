{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unflatten.dev/schemas/rfc004/alignment_hypothesis.schema.json",
  "title": "AlignmentHypothesis (RFC004 §21.2, §21.7)",
  "$comment": "Closed contract for ONE entry of a FragmentHypothesis's `alignments` array (§21.7): a closed oneOf over NodeAlignment (§21.2, multi-region), TextRangeAlignment and LeafAlignment. This is hypothesis/evidence shape only -- §21.4 forbids gold node IDs or SourceMap identity from ever reaching a production aligner's inputs, and `additionalProperties: false` on every object here means a smuggled gold-only field (e.g. a `gold_bbox_ppm`) fails validation rather than passing through silently (`test_alignment_hypothesis.py`'s no-gold-geometry mutant). Cross-field numeric orderings that JSON Schema cannot express (`scalar_start < scalar_end`, disjoint TextRangeAlignment partitions) are NOT checked here, matching `table_plan.schema.json`'s split between closed-schema shape and a separate semantic verifier -- none of those RFC004 §21.7 partition/gap invariants are implemented by this change.",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ppm_int": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "confidence_ppm": { "$ref": "#/$defs/ppm_int" },
    "continuation": {
      "enum": ["start", "middle", "end", "complete"]
    },
    "bbox_ppm": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/ppm_int" }
    },
    "polygon_point_ppm": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/ppm_int" }
    },
    "polygon_ppm": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/polygon_point_ppm" }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_ordinal", "bbox_ppm", "continuation", "confidence_ppm"],
      "properties": {
        "page_ordinal": { "type": "integer", "minimum": 0 },
        "bbox_ppm": { "$ref": "#/$defs/bbox_ppm" },
        "polygon_ppm": { "$ref": "#/$defs/polygon_ppm" },
        "continuation": { "$ref": "#/$defs/continuation" },
        "confidence_ppm": { "$ref": "#/$defs/confidence_ppm" }
      }
    },
    "node_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignment_hypothesis_schema_version",
        "kind",
        "local_node_id",
        "regions"
      ],
      "properties": {
        "alignment_hypothesis_schema_version": { "$ref": "#/$defs/semver" },
        "kind": { "const": "node" },
        "local_node_id": { "type": "string", "minLength": 1 },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/region" }
        }
      }
    },
    "text_range_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignment_hypothesis_schema_version",
        "kind",
        "text_span_local_id",
        "scalar_start",
        "scalar_end",
        "ownership_region",
        "comparison_regions",
        "coordinate_transform_hash"
      ],
      "properties": {
        "alignment_hypothesis_schema_version": { "$ref": "#/$defs/semver" },
        "kind": { "const": "text_range" },
        "text_span_local_id": { "type": "string", "minLength": 1 },
        "scalar_start": { "type": "integer", "minimum": 0 },
        "scalar_end": { "type": "integer", "minimum": 0 },
        "ownership_region": { "$ref": "#/$defs/region" },
        "comparison_regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/region" }
        },
        "coordinate_transform_hash": { "$ref": "#/$defs/sha256_hash" }
      }
    },
    "leaf_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignment_hypothesis_schema_version",
        "kind",
        "local_node_id",
        "ownership_basis",
        "region",
        "coordinate_transform_hash"
      ],
      "properties": {
        "alignment_hypothesis_schema_version": { "$ref": "#/$defs/semver" },
        "kind": { "const": "leaf" },
        "local_node_id": { "type": "string", "minLength": 1 },
        "ownership_basis": {
          "enum": [
            "direct_region",
            "preceding_text_scalar",
            "following_text_scalar",
            "structural_neighbor"
          ]
        },
        "region": {
          "oneOf": [{ "$ref": "#/$defs/region" }, { "type": "null" }]
        },
        "coordinate_transform_hash": { "$ref": "#/$defs/sha256_hash" }
      },
      "allOf": [
        {
          "if": { "properties": { "ownership_basis": { "const": "direct_region" } } },
          "then": { "properties": { "region": { "$ref": "#/$defs/region" } } }
        },
        {
          "if": {
            "properties": {
              "ownership_basis": {
                "enum": [
                  "preceding_text_scalar",
                  "following_text_scalar",
                  "structural_neighbor"
                ]
              }
            }
          },
          "then": { "properties": { "region": { "type": "null" } } }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/node_alignment" },
    { "$ref": "#/$defs/text_range_alignment" },
    { "$ref": "#/$defs/leaf_alignment" }
  ]
}
