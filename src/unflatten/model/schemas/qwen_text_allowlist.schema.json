{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unflatten.dev/schemas/rfc004/qwen_text_allowlist.schema.json",
  "title": "M1 Closed Qwen Text-ID Allowlist (design §4.2)",
  "$comment": "Closed envelope. Partitions range(native_vocab_size) into allowed text IDs and denied IDs with a closed reason set. Real vocab size and lists are generated from hash-verified tokenizer artifacts, never assumed. Ambiguous metadata must abort construction rather than be encoded here as a guess.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qwen_text_allowlist_schema_version",
    "tokenizer_artifact_set_hash",
    "native_vocab_size",
    "allowed_native_ids",
    "denied",
    "classification_policy_version",
    "control_text_check"
  ],
  "properties": {
    "qwen_text_allowlist_schema_version": { "$ref": "#/$defs/semver" },
    "tokenizer_artifact_set_hash": { "$ref": "#/$defs/sha256" },
    "native_vocab_size": { "type": "integer", "minimum": 0 },
    "allowed_native_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    },
    "denied": {
      "type": "array",
      "items": { "$ref": "#/$defs/denied_entry" }
    },
    "classification_policy_version": { "$ref": "#/$defs/semver" },
    "control_text_check": { "enum": ["applied", "skipped"] }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "denied_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_id", "reasons"],
      "properties": {
        "native_id": { "type": "integer", "minimum": 0 },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "special_token",
              "added_control",
              "chat_control",
              "vision_control",
              "tool_control",
              "pad_token",
              "unknown_token",
              "unclassified_added_token",
              "control_bearing_text"
            ]
          }
        }
      }
    }
  }
}
