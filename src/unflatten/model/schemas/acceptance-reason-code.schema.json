{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unflatten.dev/schemas/acceptance-reason-code.schema.json",
  "title": "RFC004 §35.5 Acceptance reason code registry",
  "$comment": "Generated from a closed, versioned acceptance-reason-code-registry.json. Result reason_codes must reference this registry, be unique, and be UTF-8-byte sorted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["acceptance_reason_code_registry_schema_version", "codes"],
  "properties": {
    "acceptance_reason_code_registry_schema_version": { "const": "0.1.0" },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "allowed_statuses", "allowed_scopes", "meaning", "severity", "policy_action"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "allowed_statuses": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["review_required", "rejected"] },
            "uniqueItems": true
          },
          "allowed_scopes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "meaning": { "type": "string" },
          "severity": { "enum": ["info", "warning", "error", "fatal"] },
          "policy_action": {
            "enum": [
              "continue", "continue_with_warning", "retry", "return_review_candidate",
              "return_partial", "set_acceptance_review_required", "reject", "fail_request"
            ]
          }
        }
      }
    }
  }
}
