{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unflatten.dev/schemas/rfc004/model_prediction_ir.schema.json",
  "title": "M3 Prediction IR (design §5.8 D8)",
  "$comment": "Closed envelope. Runtime-only tensor fields (NodeState.anchor/content_summary) are deliberately NOT part of this schema -- the schema covers the logical, JSON-serializable shape the AST Builder consumes, not the decode-time hidden states.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_prediction_ir_schema_version", "phase", "document_hypotheses"],
  "properties": {
    "model_prediction_ir_schema_version": { "const": "0.4.0" },
    "phase": { "const": "assembled" },
    "document_hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document_hypothesis" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "document_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragments"],
      "properties": {
        "fragments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fragment_hypothesis" }
        }
      }
    },
    "fragment_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "accepted_tokens",
        "node_states",
        "typed_predictions",
        "resource_predictions",
        "issues",
        "region_predictions"
      ],
      "properties": {
        "scope": { "$ref": "#/$defs/inference_scope" },
        "accepted_tokens": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "node_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_state" }
        },
        "typed_predictions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["local_node_id", "node_type", "pointer", "head_id", "value"],
            "properties": {
              "local_node_id": { "type": "string", "minLength": 1 },
              "node_type": { "type": "string", "minLength": 1 },
              "pointer": { "type": "string", "pattern": "^/" },
              "head_id": { "type": "string", "minLength": 1 },
              "value": { "type": ["integer", "string", "boolean", "null"] }
            }
          }
        },
        "region_predictions": {
          "type": "array",
          "items": { "$ref": "#/$defs/region_prediction" }
        },
        "resource_predictions": { "type": "array" },
        "issues": { "type": "array" }
      }
    },
    "inference_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "single_page" }
      }
    },
    "region_prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_node_id", "node_type", "alignment_status", "regions", "confidence_ppm"],
      "properties": {
        "local_node_id": { "type": "string", "minLength": 1 },
        "node_type": { "type": "string", "minLength": 1 },
        "alignment_status": { "enum": ["region", "abstain_not_visible", "abstain_container", "abstain_degenerate"] },
        "regions": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page_ordinal", "bbox_ppm", "continuation", "confidence_ppm"],
            "properties": {
              "page_ordinal": { "type": "integer", "minimum": 0 },
              "bbox_ppm": {
                "type": "array", "minItems": 4, "maxItems": 4,
                "items": { "type": "integer", "minimum": 0, "maximum": 1000000 }
              },
              "continuation": { "const": "complete" },
              "confidence_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 }
            }
          }
        },
        "confidence_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      },
      "allOf": [
        { "if": { "properties": { "alignment_status": { "const": "region" } } }, "then": { "properties": { "regions": { "minItems": 1 } } } },
        { "if": { "properties": { "alignment_status": { "enum": ["abstain_not_visible", "abstain_container", "abstain_degenerate"] } } }, "then": { "properties": { "regions": { "maxItems": 0 } } } }
      ]
    },
    "node_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_node_id",
        "slot_kind",
        "node_type",
        "parent_local_node_id",
        "open_event_index",
        "leaf_event_index",
        "resume_event_index",
        "close_event_index"
      ],
      "properties": {
        "local_node_id": { "type": "string", "minLength": 1 },
        "slot_kind": { "enum": ["opened_node", "leaf", "continuation_proxy"] },
        "node_type": { "type": "string", "minLength": 1 },
        "parent_local_node_id": { "type": ["string", "null"] },
        "open_event_index": { "type": ["integer", "null"], "minimum": 0 },
        "leaf_event_index": { "type": ["integer", "null"], "minimum": 0 },
        "resume_event_index": { "type": ["integer", "null"], "minimum": 0 },
        "close_event_index": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
