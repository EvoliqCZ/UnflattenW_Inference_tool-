{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S4.5 RL dataset manifest (RFC005-ERRATA-010 E3.1, E7.5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "split", "sources", "forbidden_sources", "rights_privacy_refs",
    "lineage_ids", "exclude_lineage_ids", "selection_hash", "dataset_manifest_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "split": { "const": "train" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": { "$ref": "#/$defs/forbidden" }
      }
    },
    "forbidden_sources": {
      "const": [
        "calibration_fit", "calibration_check", "val_real_p5_dev", "test_real_gold",
        "P6_REAL_GOLD", "locked_test", "s5_control_sample"
      ]
    },
    "rights_privacy_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "lineage_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "exclude_lineage_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "selection_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dataset_manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "forbidden": {
      "enum": [
        "calibration_fit", "calibration_check", "val_real_p5_dev", "test_real_gold",
        "P6_REAL_GOLD", "locked_test", "s5_control_sample"
      ]
    }
  }
}
