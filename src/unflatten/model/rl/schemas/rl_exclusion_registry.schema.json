{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S4.5 RL exclusion registry (design DP8 / invariant 15)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release_root_hash", "entries", "cross_release_non_train", "registry_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "release_root_hash": { "$ref": "#/$defs/sha256" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/artefact_entry" },
          { "$ref": "#/$defs/declared_absent_entry" }
        ]
      }
    },
    "cross_release_non_train": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["release_root_hash", "lineage_ids"],
        "properties": {
          "release_root_hash": { "$ref": "#/$defs/sha256" },
          "lineage_ids": { "$ref": "#/$defs/lineage_ids" }
        }
      }
    },
    "registry_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "lineage_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "label": {
      "enum": [
        "calibration_fit", "calibration_check", "val_real_p5_dev", "test_real_gold",
        "P6_REAL_GOLD", "locked_test", "s5_control_sample"
      ]
    },
    "artefact_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label", "status", "kind", "ref", "sha256", "size_bytes", "lineage_ids", "decision_ref"
      ],
      "properties": {
        "label": { "$ref": "#/$defs/label" },
        "status": { "const": "artefact" },
        "kind": { "enum": ["s5_control_sample", "selection_policy", "release_split_test"] },
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "lineage_ids": { "$ref": "#/$defs/lineage_ids" },
        "decision_ref": { "type": "null" }
      }
    },
    "declared_absent_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label", "status", "kind", "ref", "sha256", "size_bytes", "lineage_ids", "decision_ref"
      ],
      "properties": {
        "label": { "$ref": "#/$defs/label" },
        "status": { "const": "declared_absent" },
        "kind": { "type": "null" },
        "ref": { "type": "null" },
        "sha256": { "type": "null" },
        "size_bytes": { "type": "null" },
        "lineage_ids": { "type": "array", "maxItems": 0 },
        "decision_ref": { "type": ["string", "null"] }
      }
    }
  }
}
