{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S4.5 RL exposure ledger document (RFC005-ERRATA-010 E7.1/E7.5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "dataset_manifest_hash", "reward_policy_hash",
    "record_count", "last_record_hash", "records", "exposure_ledger_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "dataset_manifest_hash": { "$ref": "#/$defs/hash" },
    "reward_policy_hash": { "$ref": "#/$defs/hash" },
    "record_count": { "type": "integer", "minimum": 0 },
    "last_record_hash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
    "exposure_ledger_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_index", "run_id", "lineage_root_id", "source", "cell", "epoch",
        "view_ids", "rollout_count", "guard_intervention_counts", "rollout_seed_digest",
        "reward_policy_hash", "optimizer_step", "prev_record_hash", "record_hash"
      ],
      "properties": {
        "record_index": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string", "minLength": 1 },
        "lineage_root_id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "cell": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "epoch": { "type": "integer", "minimum": 0 },
        "view_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rollout_count": { "type": "integer", "minimum": 1 },
        "guard_intervention_counts": {
          "type": "array",
          "minItems": 1,
          "items": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] }
        },
        "rollout_seed_digest": { "$ref": "#/$defs/hash" },
        "reward_policy_hash": { "$ref": "#/$defs/hash" },
        "optimizer_step": { "type": "integer", "minimum": 0 },
        "prev_record_hash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "record_hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
